{
  "name": "@local/dsh-tinyfish-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Runs dsh's own web_search and web_fetch on TinyFish's free search and fetch APIs.",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./provider/index.mjs": "./provider/index.mjs"
  },
  "files": [
    "cordis.patch.yml",
    "provider",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
